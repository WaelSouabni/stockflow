# Local / staging / production database
DATABASE_URL="postgresql://stockflow:stockflow@localhost:5432/stockflow?schema=public"

# Required authentication secret (32+ random characters in production)
AUTH_SECRET="change-me-to-a-long-random-secret"

# Transactional email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="StockFlow <noreply@example.com>"

# Optional operational settings
BACKUP_DIR="./backups"
RETENTION_DAYS="14"
